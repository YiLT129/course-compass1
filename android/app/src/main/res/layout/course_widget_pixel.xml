<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><TextView android:fontFamily="monospace" android:id="@+id/widget_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="下一节课" android:textSize="12sp" android:textColor="#5D8296"/><TextView android:fontFamily="monospace" android:id="@+id/widget_refresh" android:layout_width="48dp" android:layout_height="36dp" android:gravity="center" android:text="刷新" android:textSize="12sp" android:textColor="#287AA0" android:contentDescription="刷新课程卡片"/></LinearLayout>
 <ImageView android:id="@+id/widget_record" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/widget_record_art" android:visibility="gone" android:contentDescription="唱片"/><TextClock android:fontFamily="monospace" android:id="@+id/widget_clock" android:layout_width="match_parent" android:layout_height="wrap_content" android:format12Hour="HH:mm" android:format24Hour="HH:mm" android:timeZone="Asia/Shanghai" android:textSize="28sp" android:visibility="gone"/>
 <TextView android:fontFamily="monospace" android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="先导入你的课表" android:textSize="20sp" android:textStyle="bold" android:textColor="#183D52" android:maxLines="2" android:ellipsize="end"/>
 <TextView android:fontFamily="monospace" android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="课程时间与教室" android:textSize="13sp" android:textColor="#406577" android:maxLines="2" android:ellipsize="end"/>
 <TextView android:fontFamily="monospace" android:id="@+id/widget_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="11sp" android:textColor="#6E8A98" android:maxLines="2" android:ellipsize="end"/>
</LinearLayout>